# ==============================================================
# Online MongoDB Atlas Connection String
# ==============================================================
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Example: MONGODB_URI=mongodb+srv://praveen:YourPassword123@cluster0.abcde.mongodb.net/chatshare?retryWrites=true&w=majority
MONGODB_URI=

# Port for local server (Default: 3000)
PORT=3000

# Secret for signing cookies and session tokens
SESSION_SECRET=chatshare-secret-key-production-3139

# (Optional) GitHub PAT Sync for Vercel Serverless
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=praveenk3139/chat-file-share
# GITHUB_BRANCH=main
